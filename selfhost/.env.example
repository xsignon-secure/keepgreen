# Copy to .env and fill in. Make each secret with: openssl rand -hex 24
# Never commit .env.

# History server: one "team:token" pair per team, comma-separated
# (or a single token for one shared space).
HISTORY_TOKENS=web:replace-me
HISTORY_RETENTION_DAYS=90

# AutoHeal dashboard
AUTOHEAL_DASHBOARD_SECRET=replace-me-upload-secret
AUTOHEAL_DASHBOARD_VIEW_TOKEN=replace-me-view-token
# Only these repos may upload (owner/name, comma-separated)
AUTOHEAL_DASHBOARD_REPOS=your-org/your-repo
# Set to 1 when the dashboard sits behind your own HTTPS reverse proxy
AUTOHEAL_TRUST_PROXY=0
